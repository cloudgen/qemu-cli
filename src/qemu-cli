# Last updated: 2026-09-27
# =============================================================================
util_cache_host_kind() {
    case "${QEMU_CLI_CACHE_HOST:-}" in
        linux|gitbash|mac)
            printf '%s' "${QEMU_CLI_CACHE_HOST}"
            return 0
            ;;
    esac
    if [ -n "${MSYSTEM:-}" ]; then
