        *) _mt_out="${_mt_key}" ;;
    esac
    case "${_mt_out}" in
        *@@*)
            _mt_left=${_mt_out%%@@*}
            _mt_right=${_mt_out#*@@}
            printf '%s%s%s' "${_mt_left}" "${_mt_extra}" "${_mt_right}"
            ;;
        *)
            printf '%s' "${_mt_out}"
            ;;
    esac
    unset _mt_key _mt_extra _mt_lang _mt_out _mt_left _mt_right
}

# Domain handlers. requirement-domain-qemu.md
# Choice prompts stay in the current shell (prompt_ask / prompt_yes_no).
# app_menu_text is not this section.

qemu_fail() {
    if [ "${QEMU_FROM_MENU:-0}" = "1" ]; then
        out_error "$*"
        return 1
    fi
    out_die "$*"
}

qemu_host_family() {
    QEMU_HOST_FAMILY="unsupported"
    _uname=$(uname -s 2>/dev/null || printf '%s' "unknown")
    case "${_uname}" in
        Darwin)
            QEMU_HOST_FAMILY="macos"
            unset _uname
            return 0
            ;;
        MINGW*|MSYS*|CYGWIN*)
            QEMU_HOST_FAMILY="unsupported"
            unset _uname
            return 0
            ;;
    esac
    if [ -n "${TERMUX_VERSION-}" ] || [ -n "${MSYSTEM-}" ]; then
        QEMU_HOST_FAMILY="unsupported"
        unset _uname
        return 0
    fi
    if [ ! -r /etc/os-release ]; then
        unset _uname
        return 0
    fi
    _id=$(awk -F= '/^ID=/{gsub(/"/,"",$2); print $2; exit}' /etc/os-release 2>/dev/null || true)
    _like=$(awk -F= '/^ID_LIKE=/{gsub(/"/,"",$2); print $2; exit}' /etc/os-release 2>/dev/null || true)
    case "${_id}" in
        alpine)
            QEMU_HOST_FAMILY="alpine"
            ;;
        rhel|centos|rocky|fedora)
            QEMU_HOST_FAMILY="redhat"
            ;;
        debian|ubuntu|linuxmint|pop)
            QEMU_HOST_FAMILY="debian"
            ;;
        *)
            case "${_like}" in
                *debian*) QEMU_HOST_FAMILY="debian" ;;
                *rhel*|*fedora*) QEMU_HOST_FAMILY="redhat" ;;
                *) QEMU_HOST_FAMILY="unsupported" ;;
            esac
            ;;
    esac
    unset _uname _id _like
}

qemu_refresh_bins() {
    QEMU_IMG_BIN=""
    QEMU_EMU_BIN=""
    if command -v qemu-img >/dev/null 2>&1; then
        QEMU_IMG_BIN=$(command -v qemu-img)
    fi
    _arch=$(uname -m 2>/dev/null || printf '%s' "unknown")
    case "${_arch}" in
        x86_64) _prefer="qemu-system-x86_64" ;;
        aarch64) _prefer="qemu-system-aarch64" ;;
        armv7l|armv6l) _prefer="qemu-system-arm" ;;
        *) _prefer="qemu-system-${_arch}" ;;
    esac
    for _cand in "${_prefer}" qemu-system-x86_64 qemu-system-aarch64 qemu-system-arm qemu-system-i386; do
        if command -v "${_cand}" >/dev/null 2>&1; then
            QEMU_EMU_BIN=$(command -v "${_cand}")
            break
        fi
    done
    unset _arch _prefer _cand
}

qemu_about_fill() {
    qemu_refresh_bins
    if [ -n "${QEMU_IMG_BIN}" ] && [ -n "${QEMU_EMU_BIN}" ]; then
        QEMU_ABOUT_PRESENT="yes"
    else
        QEMU_ABOUT_PRESENT="no"
    fi
    QEMU_ABOUT_BIN="${QEMU_EMU_BIN}"
    qemu_host_family
    QEMU_ABOUT_FAMILY="${QEMU_HOST_FAMILY}"
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    QEMU_ABOUT_IMAGE_DIR="${PERSISTENT_STORAGE_DIR}/images"
    QEMU_ABOUT_CONTAINER_DIR="${PERSISTENT_STORAGE_DIR}/containers"
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
        QEMU_ABOUT_KVM="yes"
    else
        QEMU_ABOUT_KVM="no"
    fi
}

qemu_about_human() {
    out_empty_line
    out_info "QEMU present: ${QEMU_ABOUT_PRESENT}"
    out_info "QEMU emulator: ${QEMU_ABOUT_BIN}"
    out_info "Host OS family: ${QEMU_ABOUT_FAMILY}"
    out_info "Image directory: ${QEMU_ABOUT_IMAGE_DIR}"
    out_info "Container directory: ${QEMU_ABOUT_CONTAINER_DIR}"
    out_info "KVM usable: ${QEMU_ABOUT_KVM}"
}

qemu_help_rows() {
    out_info "$(app_menu_text help_qemu_head)"
    out_plain "  setup                Install QEMU on this computer"
    out_plain "  image list           List ubuntu, rocky, alpine, busybox"
    out_plain "  image create         Create one family"
    out_plain "  image show           Show one family record"
    out_plain "  image remove         Remove one family record"
    out_plain "  container list       List containers this tool owns"
    out_plain "  container create     Create a container from an image record"
    out_plain "  container start      Start one container"
    out_plain "  container stop       Stop one container"
    out_plain "  container execute    Run one command inside a running container"
    out_plain "  container shell      Open a shell inside a running container"
    out_plain "  container remove     Remove one container record"
    out_plain "  --name               Container name"
    out_plain "  --image              Image family: ubuntu, rocky, alpine, or busybox"
    out_plain "  --memory             Memory in MiB (default 1024)"
    out_plain "  --cpus               Virtual CPUs (default 1)"
