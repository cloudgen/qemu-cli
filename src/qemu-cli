}

qemu_ensure_tree() {
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    if [ ! -d "${PERSISTENT_STORAGE_DIR}/images" ]; then
        mkdir -p "${PERSISTENT_STORAGE_DIR}/images" || {
            qemu_fail "Could not create the image directory."
            return 1
        }
    fi
    if [ ! -d "${PERSISTENT_STORAGE_DIR}/containers" ]; then
        mkdir -p "${PERSISTENT_STORAGE_DIR}/containers" || {
            qemu_fail "Could not create the container directory."
            return 1
        }
    fi
    chmod 0700 "${PERSISTENT_STORAGE_DIR}" "${PERSISTENT_STORAGE_DIR}/images" "${PERSISTENT_STORAGE_DIR}/containers" 2>/dev/null || true
    return 0
}

qemu_family_ok() {
    case "${1-}" in
        ubuntu|rocky|alpine|busybox) return 0 ;;
    esac
    return 1
}

qemu_name_ok() {
    printf '%s' "${1-}" | grep -Eq '^[a-z][a-z0-9-]{0,30}$'
}

qemu_release_ok() {
    printf '%s' "${1-}" | grep -Eq '^[0-9]+(\.[0-9]+)*$'
}

qemu_digits_ok() {
    case "${1-}" in
        ''|*[!0-9]*) return 1 ;;
        0) return 1 ;;
    esac
    return 0
}

qemu_json_get() {
    _jg_file=${1-}
    _jg_key=${2-}
    if [ ! -f "${_jg_file}" ]; then
        printf '%s' ""
        unset _jg_file _jg_key
        return 0
    fi
    awk -v key="${_jg_key}" '
        index($0, "\"" key "\"") > 0 {
            line = $0
            sub(/^[^:]*:[[:space:]]*/, "", line)
            gsub(/[,[:space:]]*$/, "", line)
            if (line ~ /^"/) {
                sub(/^"/, "", line)
                sub(/"$/, "", line)
            }
            if (line == "null") line = ""
            printf "%s", line
            exit
        }
    ' "${_jg_file}"
    unset _jg_file _jg_key
}

qemu_image_json_path() {
    printf '%s' "${PERSISTENT_STORAGE_DIR}/images/${1}.json"
}

qemu_image_disk_path() {
    printf '%s' "${PERSISTENT_STORAGE_DIR}/images/${1}.qcow2"
}

qemu_container_json_path() {
    printf '%s' "${PERSISTENT_STORAGE_DIR}/containers/${1}.json"
}

qemu_sha256_file() {
    _sf=${1-}
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "${_sf}" 2>/dev/null | awk '{print $1; exit}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "${_sf}" 2>/dev/null | awk '{print $1; exit}'
    else
        printf '%s' ""
    fi
    unset _sf
}

qemu_http_get() {
    _hg_dest=${1-}
    _hg_url=${2-}
    case "${_hg_url}" in
        https://cloud-images.ubuntu.com/*|https://download.rockylinux.org/*|https://dl-cdn.alpinelinux.org/*)
            ;;
        *)
            qemu_fail "Refusing a download outside the closed image hosts."
            unset _hg_dest _hg_url
            return 1
            ;;
    esac
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --proto '=https' --tlsv1.2 -o "${_hg_dest}" "${_hg_url}" || {
            qemu_fail "Download failed for ${_hg_url}."
            unset _hg_dest _hg_url
            return 1
        }
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "${_hg_dest}" "${_hg_url}" || {
            qemu_fail "Download failed for ${_hg_url}."
            unset _hg_dest _hg_url
            return 1
        }
    else
        qemu_fail "Need curl or wget to download an image."
        unset _hg_dest _hg_url
        return 1
    fi
    unset _hg_dest _hg_url
    return 0
}

qemu_checksum_match() {
    _cm_file=${1-}
    _cm_sums=${2-}
    _cm_base=${3-}
    _cm_want=$(awk -v b="${_cm_base}" '
        index($0, b) > 0 {
            if (match($0, /[0-9a-fA-F]{64}/)) {
                print substr($0, RSTART, RLENGTH)
                exit
            }
        }
    ' "${_cm_sums}")
    _cm_got=$(qemu_sha256_file "${_cm_file}")
    if [ -z "${_cm_want}" ] || [ -z "${_cm_got}" ]; then
        unset _cm_file _cm_sums _cm_base _cm_want _cm_got
        return 1
    fi
    if [ "${_cm_want}" = "${_cm_got}" ]; then
        QEMU_SHA256="${_cm_got}"
        unset _cm_file _cm_sums _cm_base _cm_want _cm_got
        return 0
    fi
    unset _cm_file _cm_sums _cm_base _cm_want _cm_got
    return 1
}

qemu_write_image_json() {
    _wi_fam=${1-}
    _wi_rel=${2-}
    _wi_arch=${3-}
    _wi_method=${4-}
    _wi_disk=${5-}
    _wi_url=${6-}
    _wi_sha=${7-}
    _wi_path=$(qemu_image_json_path "${_wi_fam}")
    _wi_tmp="${_wi_path}.tmp"
    {
        printf '%s\n' '{'
        printf '  "schema_version": 1,\n'
        printf '  "family": "%s",\n' "$(util_json_escape "${_wi_fam}")"
        printf '  "release": "%s",\n' "$(util_json_escape "${_wi_rel}")"
        printf '  "arch": "%s",\n' "$(util_json_escape "${_wi_arch}")"
        printf '  "method": "%s",\n' "$(util_json_escape "${_wi_method}")"
        printf '  "disk": "%s",\n' "$(util_json_escape "${_wi_disk}")"
        printf '  "source_url": "%s",\n' "$(util_json_escape "${_wi_url}")"
        printf '  "sha256": "%s"\n' "$(util_json_escape "${_wi_sha}")"
        printf '%s\n' '}'
    } > "${_wi_tmp}" || {
        rm -f "${_wi_tmp}"
        qemu_fail "Could not write the image record."
        unset _wi_fam _wi_rel _wi_arch _wi_method _wi_disk _wi_url _wi_sha _wi_path _wi_tmp
        return 1
    }
    mv "${_wi_tmp}" "${_wi_path}" || {
        rm -f "${_wi_tmp}"
        qemu_fail "Could not store the image record."
        unset _wi_fam _wi_rel _wi_arch _wi_method _wi_disk _wi_url _wi_sha _wi_path _wi_tmp
        return 1
    }
    chmod 0600 "${_wi_path}" 2>/dev/null || true
    unset _wi_fam _wi_rel _wi_arch _wi_method _wi_disk _wi_url _wi_sha _wi_path _wi_tmp
    return 0
}

qemu_family_in_use() {
    _fu_fam=${1-}
    _fu_hit=0
    if [ -d "${PERSISTENT_STORAGE_DIR}/containers" ]; then
        for _fu_json in "${PERSISTENT_STORAGE_DIR}/containers"/*.json; do
            if [ ! -f "${_fu_json}" ]; then
                continue
            fi
            _fu_got=$(qemu_json_get "${_fu_json}" "image_family")
            if [ "${_fu_got}" = "${_fu_fam}" ]; then
                _fu_hit=1
                break
            fi
        done
    fi
    if [ "${_fu_hit}" -eq 1 ]; then
        unset _fu_fam _fu_hit _fu_json _fu_got
        return 0
    fi
    unset _fu_fam _fu_hit _fu_json _fu_got
    return 1
}

qemu_confirm_or_force() {
    _cf_msg=${1-}
    if [ "${FORCE:-0}" = "1" ]; then
        unset _cf_msg
        return 0
    fi
    if [ "${TTY:-0}" -ne 1 ] || [ "${JSON:-0}" -eq 1 ] || [ "${QUIET:-0}" -eq 1 ]; then
        qemu_fail "Refusing to continue without --force when there is no terminal."
        unset _cf_msg
        return 1
    fi
    if prompt_yes_no "${_cf_msg}"; then
        unset _cf_msg
        return 0
    fi
    out_info "Left the files in place."
    unset _cf_msg
    return 2
}

qemu_pkg_debian() {
    _arch=$(uname -m 2>/dev/null || printf '%s' "unknown")
    case "${_arch}" in
        x86_64) _sys="qemu-system-x86" ;;
        aarch64|arm64|armv7l|armv6l) _sys="qemu-system-arm" ;;
        *) _sys="qemu-system-${_arch}" ;;
    esac
    DEBIAN_FRONTEND=noninteractive apt-get update || return 1
    DEBIAN_FRONTEND=noninteractive apt-get install -y "${_sys}" qemu-utils || return 1
    unset _arch _sys
    return 0
}

qemu_pkg_redhat() {
    if command -v dnf >/dev/null 2>&1; then
        dnf install -y qemu-kvm qemu-img || return 1
    elif command -v yum >/dev/null 2>&1; then
        yum install -y qemu-kvm qemu-img || return 1
    else
        qemu_fail "Need dnf or yum to install QEMU."
        return 1
    fi
    return 0
}

qemu_pkg_alpine() {
    _arch=$(uname -m 2>/dev/null || printf '%s' "unknown")
    case "${_arch}" in
        x86_64) _sys="qemu-system-x86_64" ;;
        *) _sys="qemu-system-${_arch}" ;;
    esac
    apk add --no-cache "${_sys}" qemu-img || return 1
    unset _arch _sys
    return 0
}

qemu_pkg_busybox() {
    qemu_host_family
    case "${QEMU_HOST_FAMILY}" in
        debian)
            DEBIAN_FRONTEND=noninteractive apt-get update || return 1
            DEBIAN_FRONTEND=noninteractive apt-get install -y busybox-static || \
                DEBIAN_FRONTEND=noninteractive apt-get install -y busybox || return 1
            ;;
        redhat)
            if command -v dnf >/dev/null 2>&1; then
                dnf install -y busybox || return 1
            elif command -v yum >/dev/null 2>&1; then
                yum install -y busybox || return 1
            else
                return 1
            fi
            ;;
        alpine)
            apk add --no-cache busybox-static || apk add --no-cache busybox || return 1
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

qemu_setup() {
    : "${FORCE:=0}"
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    qemu_refresh_bins
    if [ -n "${QEMU_IMG_BIN}" ] && [ -n "${QEMU_EMU_BIN}" ] && [ "${FORCE}" != "1" ]; then
        out_success "QEMU is already available."
        return 0
    fi
    qemu_host_family
    case "${QEMU_HOST_FAMILY}" in
        debian|redhat|alpine|macos) ;;
        *)
            qemu_fail "This command line cannot install QEMU."
            return 1
            ;;
    esac
    if [ "${QEMU_HOST_FAMILY}" != "macos" ]; then
        if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
            qemu_fail "Re-run ${APP_NAME} setup as the administrator. This program does not change packages for a normal login."
            return 1
        fi
    fi
    if [ "${QEMU_HOST_FAMILY}" = "macos" ]; then
        if ! command -v brew >/dev/null 2>&1; then
            qemu_fail "Homebrew is required to install QEMU on macOS."
            return 1
        fi
    fi
    if [ "${FORCE}" != "1" ] && [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
        if ! prompt_yes_no "Install QEMU packages on this computer"; then
            out_info "Left the system unchanged."
            return 0
        fi
    fi
    case "${QEMU_HOST_FAMILY}" in
        debian) qemu_pkg_debian || { qemu_fail "Package install failed."; return 1; } ;;
        redhat) qemu_pkg_redhat || { qemu_fail "Package install failed."; return 1; } ;;
        alpine) qemu_pkg_alpine || { qemu_fail "Package install failed."; return 1; } ;;
        macos) brew install qemu || { qemu_fail "Package install failed."; return 1; } ;;
    esac
    qemu_refresh_bins
    if [ -z "${QEMU_IMG_BIN}" ] || [ -z "${QEMU_EMU_BIN}" ]; then
        qemu_fail "QEMU packages finished but qemu-img or a system emulator is still missing."
        return 1
    fi
    out_success "QEMU is available."
    return 0
}

qemu_image_list() {
    qemu_ensure_tree || return 1
    for _il_fam in ubuntu rocky alpine busybox; do
        if [ -f "$(qemu_image_json_path "${_il_fam}")" ] && [ -f "$(qemu_image_disk_path "${_il_fam}")" ]; then
            _il_state="present"
        else
            _il_state="absent"
        fi
        if [ "${JSON:-0}" -eq 1 ]; then
            out_json "success" "" "family" "${_il_fam}" "state" "${_il_state}"
        else
            out_plain "${_il_fam} ${_il_state}"
        fi
    done
    unset _il_fam _il_state
    return 0
}

qemu_image_show() {
    _is_fam=${1-}
    if ! qemu_family_ok "${_is_fam}"; then
        qemu_fail "Unknown image family '${_is_fam}'."
        unset _is_fam
        return 1
    fi
    qemu_ensure_tree || { unset _is_fam; return 1; }
    _is_path=$(qemu_image_json_path "${_is_fam}")
    if [ ! -f "${_is_path}" ]; then
        qemu_fail "No image record for family '${_is_fam}'."
        unset _is_fam _is_path
        return 1
    fi
    if [ "${JSON:-0}" -eq 1 ]; then
        out_json "success" "" \
            "family" "$(qemu_json_get "${_is_path}" family)" \
            "release" "$(qemu_json_get "${_is_path}" release)" \
            "arch" "$(qemu_json_get "${_is_path}" arch)" \
            "method" "$(qemu_json_get "${_is_path}" method)" \
            "disk" "$(qemu_json_get "${_is_path}" disk)" \
            "source_url" "$(qemu_json_get "${_is_path}" source_url)" \
            "sha256" "$(qemu_json_get "${_is_path}" sha256)"
    else
        out_plain "family: $(qemu_json_get "${_is_path}" family)"
        out_plain "release: $(qemu_json_get "${_is_path}" release)"
        out_plain "arch: $(qemu_json_get "${_is_path}" arch)"
        out_plain "method: $(qemu_json_get "${_is_path}" method)"
        out_plain "disk: $(qemu_json_get "${_is_path}" disk)"
        out_plain "source_url: $(qemu_json_get "${_is_path}" source_url)"
        out_plain "sha256: $(qemu_json_get "${_is_path}" sha256)"
    fi
    unset _is_fam _is_path
    return 0
}

qemu_image_remove() {
    _ir_fam=${1-}
    if ! qemu_family_ok "${_ir_fam}"; then
        qemu_fail "Unknown image family '${_ir_fam}'."
        unset _ir_fam
        return 1
    fi
    qemu_ensure_tree || { unset _ir_fam; return 1; }
    if qemu_family_in_use "${_ir_fam}"; then
        qemu_fail "Image family ${_ir_fam} is still used by a container."
        unset _ir_fam
        return 1
    fi
    _ir_json=$(qemu_image_json_path "${_ir_fam}")
    _ir_disk=$(qemu_image_disk_path "${_ir_fam}")
    if [ ! -f "${_ir_json}" ] && [ ! -f "${_ir_disk}" ]; then
        out_success "Image family ${_ir_fam} is already absent."
        unset _ir_fam _ir_json _ir_disk
        return 0
    fi
    qemu_confirm_or_force "Remove image family ${_ir_fam}"
    _ir_rc=$?
    if [ "${_ir_rc}" -eq 2 ]; then
        unset _ir_fam _ir_json _ir_disk _ir_rc
        return 0
    fi
    if [ "${_ir_rc}" -ne 0 ]; then
        unset _ir_fam _ir_json _ir_disk _ir_rc
        return 1
    fi
    rm -f "${_ir_json}" "${_ir_disk}" "${PERSISTENT_STORAGE_DIR}/images/${_ir_fam}.kernel"
    out_success "Removed image family ${_ir_fam}."
    unset _ir_fam _ir_json _ir_disk _ir_rc
    return 0
}

qemu_cloud_spec() {
    _cs_fam=${1-}
    _cs_arch=$(uname -m 2>/dev/null || printf '%s' "unknown")
    QEMU_CLOUD_URL=""
    QEMU_CLOUD_SUMS=""
    QEMU_CLOUD_BASE=""
    QEMU_CLOUD_REL=""
    case "${_cs_fam}" in
        ubuntu)
            QEMU_CLOUD_REL=${QEMU_CLI_UBUNTU_RELEASE:-26.04}
            qemu_release_ok "${QEMU_CLOUD_REL}" || {
                qemu_fail "QEMU_CLI_UBUNTU_RELEASE must be digits and dots."
                unset _cs_fam _cs_arch
                return 1
            }
            case "${_cs_arch}" in
                x86_64) _deb=amd64 ;;
                aarch64) _deb=arm64 ;;
                *)
                    qemu_fail "Ubuntu cloud images on this architecture are not in the closed map."
                    unset _cs_fam _cs_arch _deb
                    return 1
                    ;;
            esac
            QEMU_CLOUD_BASE="ubuntu-${QEMU_CLOUD_REL}-server-cloudimg-${_deb}.img"
            QEMU_CLOUD_URL="https://cloud-images.ubuntu.com/releases/${QEMU_CLOUD_REL}/release/${QEMU_CLOUD_BASE}"
            QEMU_CLOUD_SUMS="https://cloud-images.ubuntu.com/releases/${QEMU_CLOUD_REL}/release/SHA256SUMS"
            unset _deb
            ;;
        rocky)
            QEMU_CLOUD_REL=${QEMU_CLI_ROCKY_RELEASE:-10}
            qemu_release_ok "${QEMU_CLOUD_REL}" || {
                qemu_fail "QEMU_CLI_ROCKY_RELEASE must be digits and dots."
                unset _cs_fam _cs_arch
                return 1
            }
            case "${_cs_arch}" in
                x86_64|aarch64) ;;
                *)
                    qemu_fail "Rocky cloud images on this architecture are not in the closed map."
                    unset _cs_fam _cs_arch
                    return 1
                    ;;
            esac
            QEMU_CLOUD_BASE="Rocky-${QEMU_CLOUD_REL}-GenericCloud-Base.latest.${_cs_arch}.qcow2"
            QEMU_CLOUD_URL="https://download.rockylinux.org/pub/rocky/${QEMU_CLOUD_REL}/images/${_cs_arch}/${QEMU_CLOUD_BASE}"
            QEMU_CLOUD_SUMS="https://download.rockylinux.org/pub/rocky/${QEMU_CLOUD_REL}/images/${_cs_arch}/CHECKSUM"
            ;;
        alpine)
            QEMU_CLOUD_REL=${QEMU_CLI_ALPINE_RELEASE:-3.24}
            qemu_release_ok "${QEMU_CLOUD_REL}" || {
                qemu_fail "QEMU_CLI_ALPINE_RELEASE must be digits and dots."
                unset _cs_fam _cs_arch
                return 1
            }
            QEMU_CLOUD_URL="https://dl-cdn.alpinelinux.org/alpine/v${QEMU_CLOUD_REL}/releases/cloud/"
            ;;
        *)
            qemu_fail "Unknown cloud family."
            unset _cs_fam _cs_arch
            return 1
            ;;
    esac
    QEMU_CLOUD_ARCH="${_cs_arch}"
    unset _cs_fam _cs_arch
    return 0
}

qemu_convert_qcow() {
    _cv_src=${1-}
    _cv_dest=${2-}
    qemu_refresh_bins
    if [ -z "${QEMU_IMG_BIN}" ]; then
        qemu_fail "qemu-img is missing."
        unset _cv_src _cv_dest
        return 1
    fi
    "${QEMU_IMG_BIN}" convert -O qcow2 "${_cv_src}" "${_cv_dest}" || {
        rm -f "${_cv_dest}"
        qemu_fail "qemu-img convert failed."
        unset _cv_src _cv_dest
        return 1
    }
    unset _cv_src _cv_dest
    return 0
}

qemu_image_create_cloud() {
    _ic_fam=${1-}
    qemu_cloud_spec "${_ic_fam}" || return 1
    _ic_raw=$(util_mktemp imgraw)
    _ic_sums=$(util_mktemp imgsums)
    if [ -z "${_ic_raw}" ] || [ -z "${_ic_sums}" ]; then
        rm -f "${_ic_raw}" "${_ic_sums}"
        qemu_fail "Could not create a temporary file."
        unset _ic_fam _ic_raw _ic_sums
        return 1
    fi
    if [ "${_ic_fam}" = "alpine" ]; then
        qemu_http_get "${_ic_sums}" "${QEMU_CLOUD_URL}" || {
            rm -f "${_ic_raw}" "${_ic_sums}"
            unset _ic_fam _ic_raw _ic_sums
            return 1
        }
        _ic_cands=$(awk '
            {
                line = $0
                while (match(line, /href="[^"]+\.qcow2"/)) {
                    item = substr(line, RSTART + 6, RLENGTH - 7)
                    print item
                    line = substr(line, RSTART + RLENGTH)
                }
            }
        ' "${_ic_sums}")
        _ic_generic=$(printf '%s\n' "${_ic_cands}" | awk 'BEGIN{n=0} tolower($0) ~ /generic/ && $0 ~ /\.qcow2$/ {print; n++} END{}')
        _ic_count=$(printf '%s\n' "${_ic_generic}" | awk 'NF{c++} END{print c+0}')
        if [ "${_ic_count}" -ne 1 ]; then
            out_error "Alpine generic qcow2 match count is ${_ic_count}."
            if [ -n "${_ic_cands}" ]; then
                printf '%s\n' "${_ic_cands}" | while IFS= read -r _ic_one; do
                    [ -n "${_ic_one}" ] || continue
                    out_plain "candidate: ${_ic_one}"
                done
            fi
            rm -f "${_ic_raw}" "${_ic_sums}"
            qemu_fail "Refusing an Alpine image when the generic qcow2 match is not exactly one."
            unset _ic_fam _ic_raw _ic_sums _ic_cands _ic_generic _ic_count _ic_one
            return 1
        fi
        _ic_base=$(printf '%s' "${_ic_generic}" | awk 'NF{print; exit}')
        case "${_ic_base}" in
            http*) QEMU_CLOUD_URL="${_ic_base}" ;;
            *) QEMU_CLOUD_URL="${QEMU_CLOUD_URL}${_ic_base}" ;;
        esac
        QEMU_CLOUD_BASE=$(basename "${_ic_base}")
        QEMU_CLOUD_SUMS="${QEMU_CLOUD_URL}.sha256"
        qemu_http_get "${_ic_raw}" "${QEMU_CLOUD_URL}" || {
            rm -f "${_ic_raw}" "${_ic_sums}"
            unset _ic_fam _ic_raw _ic_sums _ic_cands _ic_generic _ic_count _ic_base
            return 1
        }
        qemu_http_get "${_ic_sums}" "${QEMU_CLOUD_SUMS}" || {
            rm -f "${_ic_raw}" "${_ic_sums}"
            unset _ic_fam _ic_raw _ic_sums _ic_cands _ic_generic _ic_count _ic_base
            return 1
        }
    else
        qemu_http_get "${_ic_raw}" "${QEMU_CLOUD_URL}" || {
            rm -f "${_ic_raw}" "${_ic_sums}"
            unset _ic_fam _ic_raw _ic_sums
            return 1
        }
        qemu_http_get "${_ic_sums}" "${QEMU_CLOUD_SUMS}" || {
            rm -f "${_ic_raw}" "${_ic_sums}"
            unset _ic_fam _ic_raw _ic_sums
            return 1
        }
    fi
    if ! qemu_checksum_match "${_ic_raw}" "${_ic_sums}" "${QEMU_CLOUD_BASE}"; then
        rm -f "${_ic_raw}" "${_ic_sums}"
        qemu_fail "Vendor checksum did not match ${QEMU_CLOUD_BASE}."
        unset _ic_fam _ic_raw _ic_sums
        return 1
    fi
    _ic_disk=$(qemu_image_disk_path "${_ic_fam}")
    rm -f "${_ic_disk}"
    qemu_convert_qcow "${_ic_raw}" "${_ic_disk}" || {
        rm -f "${_ic_raw}" "${_ic_sums}" "${_ic_disk}"
        unset _ic_fam _ic_raw _ic_sums _ic_disk
        return 1
    }
    rm -f "${_ic_raw}" "${_ic_sums}"
    qemu_write_image_json "${_ic_fam}" "${QEMU_CLOUD_REL}" "${QEMU_CLOUD_ARCH}" "vendor-cloud" \
        "images/${_ic_fam}.qcow2" "${QEMU_CLOUD_URL}" "${QEMU_SHA256}" || {
        rm -f "${_ic_disk}"
        unset _ic_fam _ic_disk
        return 1
    }
    out_success "Image family ${_ic_fam} is present."
    unset _ic_fam _ic_disk
    return 0
}

qemu_image_create_busybox() {
    _ib_bb=""
    if command -v busybox >/dev/null 2>&1; then
        _ib_bb=$(command -v busybox)
    fi
    if [ -z "${_ib_bb}" ]; then
        if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
            qemu_pkg_busybox || true
            if command -v busybox >/dev/null 2>&1; then
                _ib_bb=$(command -v busybox)
            fi
        fi
    fi
    if [ -z "${_ib_bb}" ]; then
        qemu_fail "Static BusyBox is missing. Re-run as the administrator or place busybox on PATH."
        unset _ib_bb
        return 1
    fi
    if [ -z "${QEMU_CLI_KERNEL-}" ] || [ ! -f "${QEMU_CLI_KERNEL}" ]; then
        qemu_fail "Set QEMU_CLI_KERNEL to a local vmlinuz. This tool does not download a kernel."
        unset _ib_bb
        return 1
    fi
    if ! command -v mke2fs >/dev/null 2>&1 && ! command -v mkfs.ext4 >/dev/null 2>&1; then
        qemu_fail "mke2fs is missing. Cannot build the busybox disk."
        unset _ib_bb
        return 1
    fi
    if ! command -v debugfs >/dev/null 2>&1; then
        qemu_fail "debugfs is missing. Cannot build the busybox disk."
        unset _ib_bb
        return 1
    fi
    qemu_refresh_bins
    if [ -z "${QEMU_IMG_BIN}" ]; then
        qemu_fail "qemu-img is missing."
        unset _ib_bb
        return 1
    fi
    _ib_raw=$(util_mktemp bbraw)
    if [ -z "${_ib_raw}" ]; then
        qemu_fail "Could not create a temporary file."
        unset _ib_bb _ib_raw
        return 1
    fi
    dd if=/dev/zero of="${_ib_raw}" bs=1M count=32 >/dev/null 2>&1 || {
        rm -f "${_ib_raw}"
        qemu_fail "Could not allocate the busybox disk."
        unset _ib_bb _ib_raw
        return 1
    }
    if command -v mke2fs >/dev/null 2>&1; then
        mke2fs -F -t ext4 -L busybox "${_ib_raw}" >/dev/null 2>&1 || {
            rm -f "${_ib_raw}"
            qemu_fail "mke2fs failed for the busybox disk."
            unset _ib_bb _ib_raw
            return 1
        }
    else
        mkfs.ext4 -F -L busybox "${_ib_raw}" >/dev/null 2>&1 || {
            rm -f "${_ib_raw}"
            qemu_fail "mkfs.ext4 failed for the busybox disk."
            unset _ib_bb _ib_raw
            return 1
        }
    fi
    _ib_init=$(util_mktemp bbinit)
    if [ -z "${_ib_init}" ]; then
        rm -f "${_ib_raw}"
        qemu_fail "Could not create a temporary file."
        unset _ib_bb _ib_raw _ib_init
        return 1
    fi
    cat > "${_ib_init}" <<'EOF'
#!/bin/busybox sh
/bin/busybox mkdir -p /proc /sys /dev
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sys /sys
exec /bin/busybox sh
EOF
    debugfs -w -R "mkdir bin" "${_ib_raw}" >/dev/null 2>&1 || true
    debugfs -w -R "write ${_ib_bb} bin/busybox" "${_ib_raw}" >/dev/null 2>&1 || {
        rm -f "${_ib_raw}" "${_ib_init}"
        qemu_fail "debugfs could not copy BusyBox."
        unset _ib_bb _ib_raw _ib_init
        return 1
    }
    debugfs -w -R "symlink busybox bin/sh" "${_ib_raw}" >/dev/null 2>&1 || true
    debugfs -w -R "write ${_ib_init} init" "${_ib_raw}" >/dev/null 2>&1 || true
    rm -f "${_ib_init}"
    _ib_disk=$(qemu_image_disk_path "busybox")
    rm -f "${_ib_disk}"
    qemu_convert_qcow "${_ib_raw}" "${_ib_disk}" || {
        rm -f "${_ib_raw}"
        unset _ib_bb _ib_raw _ib_disk
        return 1
    }
    rm -f "${_ib_raw}"
    printf '%s\n' "${QEMU_CLI_KERNEL}" > "${PERSISTENT_STORAGE_DIR}/images/busybox.kernel" || {
        qemu_fail "Could not record the local kernel path."
        unset _ib_bb _ib_disk
        return 1
    }
    chmod 0600 "${PERSISTENT_STORAGE_DIR}/images/busybox.kernel" 2>/dev/null || true
    _ib_arch=$(uname -m 2>/dev/null || printf '%s' "unknown")
    qemu_write_image_json "busybox" "" "${_ib_arch}" "local-static" "images/busybox.qcow2" "" "" || {
        rm -f "${_ib_disk}"
        unset _ib_bb _ib_disk _ib_arch
        return 1
    }
    out_success "Image family busybox is present."
    unset _ib_bb _ib_disk _ib_arch
    return 0
}

qemu_image_create() {
    _icr_fam=""
    while [ $# -gt 0 ]; do
        case "${1}" in
            --force) FORCE=1; shift ;;
            *)
                if [ -z "${_icr_fam}" ]; then
                    _icr_fam=${1}
                    shift
                else
                    qemu_fail "Unknown argument for image create: ${1}."
                    unset _icr_fam
                    return 1
                fi
                ;;
        esac
    done
    if ! qemu_family_ok "${_icr_fam}"; then
        qemu_fail "Unknown image family '${_icr_fam}'."
        unset _icr_fam
        return 1
    fi
    qemu_ensure_tree || { unset _icr_fam; return 1; }
    _icr_json=$(qemu_image_json_path "${_icr_fam}")
    _icr_disk=$(qemu_image_disk_path "${_icr_fam}")
    if [ -f "${_icr_json}" ] && [ -f "${_icr_disk}" ] && [ "${FORCE:-0}" != "1" ]; then
        out_success "Image family ${_icr_fam} is already present."
        unset _icr_fam _icr_json _icr_disk
        return 0
    fi
    if [ "${FORCE:-0}" = "1" ] && qemu_family_in_use "${_icr_fam}"; then
        qemu_fail "Image family ${_icr_fam} is still used by a container."
        unset _icr_fam _icr_json _icr_disk
        return 1
    fi
    if [ "${_icr_fam}" = "busybox" ]; then
        qemu_image_create_busybox
        _icr_rc=$?
    else
        qemu_image_create_cloud "${_icr_fam}"
        _icr_rc=$?
    fi
    unset _icr_fam _icr_json _icr_disk
    return ${_icr_rc}
}

qemu_image_main() {
    _im_sub=${1-}
    if [ $# -gt 0 ]; then
        shift
    fi
    case "${_im_sub}" in
        ""|list)
            qemu_image_list
            ;;
        create)
            qemu_image_create "$@"
            ;;
        show)
            qemu_image_show "${1-}"
            ;;
        remove)
            _im_fam=""
            while [ $# -gt 0 ]; do
                case "${1}" in
                    --force) FORCE=1; shift ;;
                    *)
                        if [ -z "${_im_fam}" ]; then
                            _im_fam=${1}
                        fi
                        shift
                        ;;
                esac
            done
            qemu_image_remove "${_im_fam}"
            _im_rc=$?
            unset _im_fam
            return ${_im_rc}
            ;;
        *)
            qemu_fail "Unknown image command '${_im_sub}'. See '${APP_NAME} help'."
            unset _im_sub
            return 1
            ;;
    esac
}

qemu_take_flag() {
    QEMU_ARG_NAME=""
    QEMU_ARG_IMAGE=""
    QEMU_ARG_MEMORY=""
    QEMU_ARG_CPUS=""
    QEMU_ARG_POS=""
    while [ $# -gt 0 ]; do
        case "${1}" in
            --force) FORCE=1; shift ;;
            --name)
                QEMU_ARG_NAME=${2-}
                shift 2 || { qemu_fail "--name needs a value."; return 1; }
                ;;
            --image)
                QEMU_ARG_IMAGE=${2-}
                shift 2 || { qemu_fail "--image needs a value."; return 1; }
                ;;
            --memory)
                QEMU_ARG_MEMORY=${2-}
                shift 2 || { qemu_fail "--memory needs a value."; return 1; }
                ;;
            --cpus)
                QEMU_ARG_CPUS=${2-}
                shift 2 || { qemu_fail "--cpus needs a value."; return 1; }
                ;;
            --)
                shift
                QEMU_ARG_POS="$*"
                break
                ;;
            *)
                if [ -z "${QEMU_ARG_POS}" ]; then
                    QEMU_ARG_POS=${1}
                else
                    QEMU_ARG_POS="${QEMU_ARG_POS} ${1}"
                fi
                shift
                ;;
        esac
    done
    return 0
}

qemu_container_load() {
    _cl_name=${1-}
    QEMU_C_JSON=$(qemu_container_json_path "${_cl_name}")
    if [ ! -f "${QEMU_C_JSON}" ]; then
        qemu_fail "No container record for '${_cl_name}'."
        unset _cl_name
        return 1
    fi
    QEMU_C_NAME=$(qemu_json_get "${QEMU_C_JSON}" "name")
    QEMU_C_FAMILY=$(qemu_json_get "${QEMU_C_JSON}" "image_family")
    QEMU_C_DISK=$(qemu_json_get "${QEMU_C_JSON}" "disk")
    QEMU_C_STATE=$(qemu_json_get "${QEMU_C_JSON}" "state")
    QEMU_C_PID=$(qemu_json_get "${QEMU_C_JSON}" "pid")
    QEMU_C_ACCEL=$(qemu_json_get "${QEMU_C_JSON}" "accel")
    QEMU_C_PORT=$(qemu_json_get "${QEMU_C_JSON}" "ssh_port")
    QEMU_C_MEM=$(qemu_json_get "${QEMU_C_JSON}" "memory_mib")
    QEMU_C_CPUS=$(qemu_json_get "${QEMU_C_JSON}" "cpus")
    if [ "${QEMU_C_STATE}" = "running" ] && [ -n "${QEMU_C_PID}" ]; then
        if ! kill -0 "${QEMU_C_PID}" 2>/dev/null; then
            QEMU_C_STATE="stopped"
            QEMU_C_PID=""
            qemu_container_store || true
        fi
    fi
    unset _cl_name
    return 0
}

qemu_container_store() {
    _cs_path="${QEMU_C_JSON}"
    _cs_tmp="${_cs_path}.tmp"
    if [ -n "${QEMU_C_PID}" ]; then
        _cs_pid="${QEMU_C_PID}"
    else
        _cs_pid="null"
    fi
    if [ -n "${QEMU_C_PORT}" ]; then
        _cs_port="${QEMU_C_PORT}"
    else
        _cs_port="null"
    fi
    {
        printf '%s\n' '{'
        printf '  "schema_version": 1,\n'
        printf '  "name": "%s",\n' "$(util_json_escape "${QEMU_C_NAME}")"
        printf '  "image_family": "%s",\n' "$(util_json_escape "${QEMU_C_FAMILY}")"
        printf '  "disk": "%s",\n' "$(util_json_escape "${QEMU_C_DISK}")"
        printf '  "state": "%s",\n' "$(util_json_escape "${QEMU_C_STATE}")"
        printf '  "pid": %s,\n' "${_cs_pid}"
        printf '  "accel": "%s",\n' "$(util_json_escape "${QEMU_C_ACCEL}")"
        if [ "${_cs_port}" = "null" ]; then
            printf '  "ssh_port": null,\n'
        else
            printf '  "ssh_port": %s,\n' "${_cs_port}"
        fi
        printf '  "memory_mib": %s,\n' "${QEMU_C_MEM}"
        printf '  "cpus": %s\n' "${QEMU_C_CPUS}"
        printf '%s\n' '}'
    } > "${_cs_tmp}" || {
        rm -f "${_cs_tmp}"
        qemu_fail "Could not write the container record."
        unset _cs_path _cs_tmp _cs_pid _cs_port
        return 1
    }
    mv "${_cs_tmp}" "${_cs_path}" || {
        rm -f "${_cs_tmp}"
        qemu_fail "Could not store the container record."
        unset _cs_path _cs_tmp _cs_pid _cs_port
        return 1
    }
    chmod 0600 "${_cs_path}" 2>/dev/null || true
    unset _cs_path _cs_tmp _cs_pid _cs_port
    return 0
}

qemu_container_list() {
    qemu_ensure_tree || return 1
    qemu_container_names
    if [ "${QEMU_NAME_COUNT}" -eq 0 ]; then
        if [ "${JSON:-0}" -eq 1 ]; then
            out_json "success" "" "count" "0"
        else
            out_plain "No containers exist yet."
        fi
        qemu_container_names_clear
        return 0
    fi
    _i=1
    while [ "${_i}" -le "${QEMU_NAME_COUNT}" ]; do
        eval "_nm=\${QEMU_NAME_${_i}}"
        _st=$(qemu_json_get "$(qemu_container_json_path "${_nm}")" "state")
        if [ "${JSON:-0}" -eq 1 ]; then
            out_json "success" "" "name" "${_nm}" "state" "${_st}"
        else
            out_plain "${_nm} ${_st}"
        fi
        _i=$((_i + 1))
    done
    qemu_container_names_clear
    unset _i _nm _st
    return 0
}

qemu_container_create() {
    qemu_take_flag "$@" || return 1
    qemu_ensure_tree || return 1
    _cc_name="${QEMU_ARG_NAME}"
    if [ -z "${_cc_name}" ]; then
        _cc_name="${QEMU_ARG_POS}"
        QEMU_ARG_POS=""
    fi
    if [ -z "${_cc_name}" ]; then
        if [ "${TTY:-0}" -ne 1 ] || [ "${JSON:-0}" -eq 1 ] || [ "${QUIET:-0}" -eq 1 ]; then
            qemu_fail "Container name is required."
            return 1
        fi
        prompt_ask "Name for this container" ""
        _cc_name="${PROMPT_ASK_VALUE}"
    fi
    if ! qemu_name_ok "${_cc_name}"; then
        qemu_fail "Container name must match ^[a-z][a-z0-9-]{0,30}$."
        unset _cc_name
        return 1
    fi
    _cc_image="${QEMU_ARG_IMAGE}"
    if [ -z "${_cc_image}" ]; then
        if [ "${TTY:-0}" -ne 1 ] || [ "${JSON:-0}" -eq 1 ] || [ "${QUIET:-0}" -eq 1 ]; then
            qemu_fail "Image family is required."
            unset _cc_name _cc_image
            return 1
        fi
        prompt_ask "Image family: ubuntu, rocky, alpine, or busybox" ""
        _cc_image="${PROMPT_ASK_VALUE}"
    fi
    if ! qemu_family_ok "${_cc_image}"; then
        qemu_fail "Unknown image family '${_cc_image}'."
        unset _cc_name _cc_image
        return 1
    fi
    if [ ! -f "$(qemu_image_json_path "${_cc_image}")" ] || [ ! -f "$(qemu_image_disk_path "${_cc_image}")" ]; then
        qemu_fail "No image record for family '${_cc_image}'. Create the image first."
        unset _cc_name _cc_image
        return 1
    fi
    if [ -f "$(qemu_container_json_path "${_cc_name}")" ]; then
        out_success "Container ${_cc_name} is already present."
        unset _cc_name _cc_image
        return 0
    fi
    _cc_mem="${QEMU_ARG_MEMORY}"
    if [ -z "${_cc_mem}" ]; then
        if [ "${TTY:-0}" -eq 1 ] && [ "${JSON:-0}" -eq 0 ] && [ "${QUIET:-0}" -eq 0 ]; then
            prompt_ask "Memory in MiB" "1024"
            _cc_mem="${PROMPT_ASK_VALUE}"
        else
            _cc_mem="1024"
        fi
    fi
    if ! qemu_digits_ok "${_cc_mem}"; then
        qemu_fail "Memory in MiB must be a positive integer."
        unset _cc_name _cc_image _cc_mem
        return 1
    fi
    _cc_cpus="${QEMU_ARG_CPUS}"
    if [ -z "${_cc_cpus}" ]; then
        if [ "${TTY:-0}" -eq 1 ] && [ "${JSON:-0}" -eq 0 ] && [ "${QUIET:-0}" -eq 0 ]; then
            prompt_ask "Virtual CPUs" "1"
            _cc_cpus="${PROMPT_ASK_VALUE}"
        else
            _cc_cpus="1"
        fi
    fi
    if ! qemu_digits_ok "${_cc_cpus}"; then
        qemu_fail "Virtual CPUs must be a positive integer."
        unset _cc_name _cc_image _cc_mem _cc_cpus
        return 1
    fi
    qemu_refresh_bins
    if [ -z "${QEMU_IMG_BIN}" ]; then
        qemu_fail "qemu-img is missing."
        unset _cc_name _cc_image _cc_mem _cc_cpus
        return 1
    fi
    _cc_base=$(qemu_image_disk_path "${_cc_image}")
    _cc_over="${PERSISTENT_STORAGE_DIR}/containers/${_cc_name}.qcow2"
    "${QEMU_IMG_BIN}" create -f qcow2 -b "${_cc_base}" -F qcow2 "${_cc_over}" >/dev/null 2>&1 || {
        rm -f "${_cc_over}"
        qemu_fail "Could not create the container disk overlay."
        unset _cc_name _cc_image _cc_mem _cc_cpus _cc_base _cc_over
        return 1
    }
    if [ "${_cc_image}" != "busybox" ]; then
        if ! command -v ssh-keygen >/dev/null 2>&1; then
            rm -f "${_cc_over}"
            qemu_fail "ssh-keygen is missing."
            unset _cc_name _cc_image _cc_mem _cc_cpus _cc_base _cc_over
            return 1
        fi
        _cc_key="${PERSISTENT_STORAGE_DIR}/containers/${_cc_name}.key"
        rm -f "${_cc_key}" "${_cc_key}.pub"
        ssh-keygen -t ed25519 -N '' -f "${_cc_key}" -q >/dev/null 2>&1 || {
            rm -f "${_cc_over}" "${_cc_key}" "${_cc_key}.pub"
            qemu_fail "ssh-keygen failed."
            unset _cc_name _cc_image _cc_mem _cc_cpus _cc_base _cc_over _cc_key
            return 1
        }
        chmod 0600 "${_cc_key}" 2>/dev/null || true
        rm -f "${_cc_key}.pub"
        _cc_pub=$(ssh-keygen -y -f "${_cc_key}" 2>/dev/null || true)
        if [ -z "${_cc_pub}" ]; then
            rm -f "${_cc_over}" "${_cc_key}"
            qemu_fail "Could not derive the public key."
            unset _cc_name _cc_image _cc_mem _cc_cpus _cc_base _cc_over _cc_key _cc_pub
            return 1
        fi
        _cc_seed="${PERSISTENT_STORAGE_DIR}/containers/${_cc_name}-cidata"
        mkdir -p "${_cc_seed}" || {
            qemu_fail "Could not create the seed directory."
            unset _cc_name _cc_image _cc_mem _cc_cpus _cc_base _cc_over _cc_key _cc_pub _cc_seed
            return 1
        }
        chmod 0700 "${_cc_seed}" 2>/dev/null || true
        {
            printf '%s\n' '#cloud-config'
            printf '%s\n' "hostname: ${_cc_name}"
            printf '%s\n' 'users:'
            printf '%s\n' '  - name: qemu-cli'
            printf '%s\n' '    lock_passwd: true'
            printf '%s\n' '    shell: /bin/sh'
            printf '%s\n' '    ssh_authorized_keys:'
            printf '%s\n' "      - ${_cc_pub}"
        } > "${_cc_seed}/user-data"
        printf '%s\n' "instance-id: ${_cc_name}" > "${_cc_seed}/meta-data"
        printf '%s\n' "local-hostname: ${_cc_name}" >> "${_cc_seed}/meta-data"
        chmod 0600 "${_cc_seed}/user-data" "${_cc_seed}/meta-data" 2>/dev/null || true
        out_info "SSH key path: ${_cc_key}"
        unset _cc_pub _cc_key _cc_seed
    fi
    QEMU_C_JSON=$(qemu_container_json_path "${_cc_name}")
    QEMU_C_NAME="${_cc_name}"
    QEMU_C_FAMILY="${_cc_image}"
    QEMU_C_DISK="containers/${_cc_name}.qcow2"
    QEMU_C_STATE="stopped"
    QEMU_C_PID=""
    QEMU_C_ACCEL=""
    QEMU_C_PORT=""
    QEMU_C_MEM="${_cc_mem}"
    QEMU_C_CPUS="${_cc_cpus}"
    qemu_container_store || {
        unset _cc_name _cc_image _cc_mem _cc_cpus _cc_base _cc_over
        return 1
    }
    out_success "Container ${_cc_name} is present."
    unset _cc_name _cc_image _cc_mem _cc_cpus _cc_base _cc_over
    return 0
}

qemu_pick_port() {
    _pp=2222
    while [ "${_pp}" -le 2999 ]; do
        _pp_used=0
        if [ -d "${PERSISTENT_STORAGE_DIR}/containers" ]; then
            for _pp_json in "${PERSISTENT_STORAGE_DIR}/containers"/*.json; do
                if [ ! -f "${_pp_json}" ]; then
                    continue
                fi
                _pp_got=$(qemu_json_get "${_pp_json}" "ssh_port")
                if [ "${_pp_got}" = "${_pp}" ]; then
                    _pp_used=1
                    break
                fi
            done
        fi
        if [ "${_pp_used}" -eq 0 ]; then
            QEMU_PICK_PORT="${_pp}"
            unset _pp _pp_used _pp_json _pp_got
            return 0
        fi
        _pp=$((_pp + 1))
    done
    qemu_fail "No free loopback port from 2222."
    unset _pp _pp_used _pp_json _pp_got
    return 1
}

qemu_pick_accel() {
    QEMU_ACCEL="tcg"
    if [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]; then
        if "${QEMU_EMU_BIN}" -accel help 2>/dev/null | grep -q hvf; then
            QEMU_ACCEL="hvf"
            return 0
        fi
        out_warn "HVF is not available. Using TCG."
        return 0
    fi
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
        QEMU_ACCEL="kvm"
        return 0
    fi
    out_warn "KVM is not usable. Using TCG."
    return 0
}

qemu_make_seed_iso() {
    _mi_dir=${1-}
    _mi_iso=${2-}
    if command -v xorriso >/dev/null 2>&1; then
        xorriso -as mkisofs -o "${_mi_iso}" -V cidata -J -R "${_mi_dir}" >/dev/null 2>&1 || return 1
    elif command -v genisoimage >/dev/null 2>&1; then
        genisoimage -o "${_mi_iso}" -V cidata -J -R "${_mi_dir}" >/dev/null 2>&1 || return 1
    elif command -v mkisofs >/dev/null 2>&1; then
        mkisofs -o "${_mi_iso}" -V cidata -J -R "${_mi_dir}" >/dev/null 2>&1 || return 1
    else
        qemu_fail "Need xorriso, genisoimage, or mkisofs to build the NoCloud seed."
        unset _mi_dir _mi_iso
        return 1
    fi
    unset _mi_dir _mi_iso
    return 0
}

qemu_container_start() {
    _st_name=${1-}
    if ! qemu_name_ok "${_st_name}"; then
        qemu_fail "Unknown container name '${_st_name}'."
        unset _st_name
        return 1
    fi
    qemu_ensure_tree || { unset _st_name; return 1; }
    qemu_container_load "${_st_name}" || { unset _st_name; return 1; }
    if [ "${QEMU_C_STATE}" = "running" ]; then
        out_success "Container ${_st_name} is already running."
        unset _st_name
        return 0
    fi
    qemu_refresh_bins
    if [ -z "${QEMU_EMU_BIN}" ]; then
        qemu_fail "A QEMU system emulator is missing."
        unset _st_name
        return 1
    fi
    qemu_pick_accel || { unset _st_name; return 1; }
    _st_over="${PERSISTENT_STORAGE_DIR}/${QEMU_C_DISK}"
    if [ ! -f "${_st_over}" ]; then
        qemu_fail "Container disk is missing."
        unset _st_name _st_over
        return 1
    fi
    _st_mon="${PERSISTENT_STORAGE_DIR}/containers/${_st_name}.monitor"
    _st_pidf="${PERSISTENT_STORAGE_DIR}/containers/${_st_name}.pid"
    _st_log="${PERSISTENT_STORAGE_DIR}/containers/${_st_name}.log"
    rm -f "${_st_mon}" "${_st_pidf}"
    _st_arch=$(uname -m 2>/dev/null || printf '%s' "unknown")
    case "${_st_arch}" in
        x86_64) _st_mach="q35" ;;
        aarch64) _st_mach="virt" ;;
        *) _st_mach="" ;;
    esac
    if [ "${QEMU_C_FAMILY}" = "busybox" ]; then
        _st_kern=""
        if [ -f "${PERSISTENT_STORAGE_DIR}/images/busybox.kernel" ]; then
            _st_kern=$(awk 'NR==1{print; exit}' "${PERSISTENT_STORAGE_DIR}/images/busybox.kernel")
        fi
        if [ -z "${_st_kern}" ] || [ ! -f "${_st_kern}" ]; then
            qemu_fail "Set QEMU_CLI_KERNEL to a local vmlinuz. This tool does not download a kernel."
            unset _st_name _st_over _st_mon _st_pidf _st_log _st_arch _st_mach _st_kern
            return 1
        fi
        _st_ser="${PERSISTENT_STORAGE_DIR}/containers/${_st_name}.serial"
        rm -f "${_st_ser}"
        if [ -n "${_st_mach}" ]; then
            "${QEMU_EMU_BIN}" -machine "${_st_mach}" -accel "${QEMU_ACCEL}" -m "${QEMU_C_MEM}" -smp "${QEMU_C_CPUS}" \
                -kernel "${_st_kern}" -append "console=ttyS0 root=/dev/vda rw init=/init" \
                -drive "file=${_st_over},if=virtio,format=qcow2" \
                -serial "unix:${_st_ser},server,nowait" \
                -monitor "unix:${_st_mon},server,nowait" \
                -display none -daemonize -pidfile "${_st_pidf}" -D "${_st_log}" || {
                qemu_fail "QEMU failed to start container ${_st_name}."
                unset _st_name _st_over _st_mon _st_pidf _st_log _st_arch _st_mach _st_kern _st_ser
                return 1
            }
        else
            "${QEMU_EMU_BIN}" -accel "${QEMU_ACCEL}" -m "${QEMU_C_MEM}" -smp "${QEMU_C_CPUS}" \
                -kernel "${_st_kern}" -append "console=ttyS0 root=/dev/vda rw init=/init" \
                -drive "file=${_st_over},if=virtio,format=qcow2" \
                -serial "unix:${_st_ser},server,nowait" \
                -monitor "unix:${_st_mon},server,nowait" \
                -display none -daemonize -pidfile "${_st_pidf}" -D "${_st_log}" || {
                qemu_fail "QEMU failed to start container ${_st_name}."
                unset _st_name _st_over _st_mon _st_pidf _st_log _st_arch _st_mach _st_kern _st_ser
                return 1
            }
        fi
        chmod 0600 "${_st_ser}" "${_st_mon}" 2>/dev/null || true
    else
        qemu_pick_port || { unset _st_name; return 1; }
        _st_seed="${PERSISTENT_STORAGE_DIR}/containers/${_st_name}-cidata"
        _st_iso="${PERSISTENT_STORAGE_DIR}/containers/${_st_name}-cidata.iso"
        if [ ! -d "${_st_seed}" ]; then
            qemu_fail "NoCloud seed is missing for ${_st_name}."
            unset _st_name _st_over _st_mon _st_pidf _st_log _st_arch _st_mach _st_seed _st_iso
            return 1
        fi
        qemu_make_seed_iso "${_st_seed}" "${_st_iso}" || { unset _st_name; return 1; }
        if [ -n "${_st_mach}" ]; then
            "${QEMU_EMU_BIN}" -machine "${_st_mach}" -accel "${QEMU_ACCEL}" -m "${QEMU_C_MEM}" -smp "${QEMU_C_CPUS}" \
                -drive "file=${_st_over},if=virtio,format=qcow2" \
                -drive "file=${_st_iso},media=cdrom,readonly=on,format=raw" \
                -nic "user,model=virtio,hostfwd=tcp:127.0.0.1:${QEMU_PICK_PORT}-:22" \
                -monitor "unix:${_st_mon},server,nowait" \
                -display none -daemonize -pidfile "${_st_pidf}" -D "${_st_log}" || {
                qemu_fail "QEMU failed to start container ${_st_name}."
                unset _st_name
                return 1
            }
        else
            "${QEMU_EMU_BIN}" -accel "${QEMU_ACCEL}" -m "${QEMU_C_MEM}" -smp "${QEMU_C_CPUS}" \
                -drive "file=${_st_over},if=virtio,format=qcow2" \
                -drive "file=${_st_iso},media=cdrom,readonly=on,format=raw" \
                -nic "user,model=virtio,hostfwd=tcp:127.0.0.1:${QEMU_PICK_PORT}-:22" \
                -monitor "unix:${_st_mon},server,nowait" \
                -display none -daemonize -pidfile "${_st_pidf}" -D "${_st_log}" || {
                qemu_fail "QEMU failed to start container ${_st_name}."
                unset _st_name
                return 1
            }
        fi
        chmod 0600 "${_st_mon}" 2>/dev/null || true
        QEMU_C_PORT="${QEMU_PICK_PORT}"
    fi
    if [ ! -f "${_st_pidf}" ]; then
        qemu_fail "QEMU did not write a pid file for ${_st_name}."
        unset _st_name
        return 1
    fi
    QEMU_C_PID=$(awk 'NR==1{print; exit}' "${_st_pidf}")
    if [ -z "${QEMU_C_PID}" ] || ! kill -0 "${QEMU_C_PID}" 2>/dev/null; then
        qemu_fail "QEMU exited immediately for ${_st_name}."
        QEMU_C_STATE="stopped"
        QEMU_C_PID=""
        qemu_container_store || true
        unset _st_name
        return 1
    fi
    QEMU_C_STATE="running"
    QEMU_C_ACCEL="${QEMU_ACCEL}"
    qemu_container_store || { unset _st_name; return 1; }
    out_success "Container ${_st_name} is running."
    unset _st_name
    return 0
}

qemu_container_stop() {
    _sp_name=${1-}
    if ! qemu_name_ok "${_sp_name}"; then
        qemu_fail "Unknown container name '${_sp_name}'."
        unset _sp_name
        return 1
    fi
    qemu_ensure_tree || { unset _sp_name; return 1; }
    qemu_container_load "${_sp_name}" || { unset _sp_name; return 1; }
    if [ "${QEMU_C_STATE}" != "running" ]; then
        out_success "Container ${_sp_name} is already stopped."
        unset _sp_name
        return 0
    fi
    _sp_mon="${PERSISTENT_STORAGE_DIR}/containers/${_sp_name}.monitor"
    if command -v python3 >/dev/null 2>&1 && [ -S "${_sp_mon}" ]; then
        python3 - "${_sp_mon}" <<'PY' || true
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
try:
    s.connect(sys.argv[1])
    s.sendall(b"system_powerdown\n")
except Exception:
    sys.exit(0)
PY
        _sp_i=0
        while [ "${_sp_i}" -lt 30 ]; do
            if ! kill -0 "${QEMU_C_PID}" 2>/dev/null; then
                break
            fi
            sleep 1
            _sp_i=$((_sp_i + 1))
        done
    else
        out_warn "python3 or the monitor socket is missing. Terminating QEMU."
    fi
    if [ -n "${QEMU_C_PID}" ] && kill -0 "${QEMU_C_PID}" 2>/dev/null; then
        kill "${QEMU_C_PID}" 2>/dev/null || true
        sleep 1
        if kill -0 "${QEMU_C_PID}" 2>/dev/null; then
            kill -9 "${QEMU_C_PID}" 2>/dev/null || true
        fi
    fi
    QEMU_C_STATE="stopped"
    QEMU_C_PID=""
    QEMU_C_PORT=""
    qemu_container_store || { unset _sp_name; return 1; }
    rm -f "${PERSISTENT_STORAGE_DIR}/containers/${_sp_name}.pid" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_sp_name}.monitor" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_sp_name}.serial"
    out_success "Container ${_sp_name} is stopped."
    unset _sp_name _sp_mon _sp_i
    return 0
}

qemu_container_require_running() {
    _rr_name=${1-}
    _rr_verb=${2-}
    qemu_container_load "${_rr_name}" || return 1
    if [ "${QEMU_C_STATE}" != "running" ]; then
        qemu_fail "Container '${_rr_name}' is stopped. Start it before ${_rr_verb}."
        unset _rr_name _rr_verb
        return 1
    fi
    unset _rr_name _rr_verb
    return 0
}

qemu_ssh_run() {
    _sr_name=${1-}
    shift
    if ! command -v ssh >/dev/null 2>&1; then
        qemu_fail "ssh is missing."
        unset _sr_name
        return 1
    fi
    _sr_key="${PERSISTENT_STORAGE_DIR}/containers/${_sr_name}.key"
    if [ ! -f "${_sr_key}" ]; then
        qemu_fail "SSH key is missing for ${_sr_name}."
        unset _sr_name _sr_key
        return 1
    fi
    ssh -o BatchMode=yes -o IdentitiesOnly=yes -o IdentityAgent=none \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -i "${_sr_key}" -p "${QEMU_C_PORT}" qemu-cli@127.0.0.1 "$@"
    _sr_rc=$?
    unset _sr_name _sr_key
    return ${_sr_rc}
}

qemu_serial_run() {
    _se_sock=${1-}
    shift
    _se_cmd=$*
    if ! command -v python3 >/dev/null 2>&1; then
        qemu_fail "python3 is missing. BusyBox execute and shell need python3."
        unset _se_sock _se_cmd
        return 1
    fi
    if [ ! -S "${_se_sock}" ]; then
        qemu_fail "Serial socket is missing."
        unset _se_sock _se_cmd
        return 1
    fi
    python3 - "${_se_sock}" "${_se_cmd}" <<'PY'
import socket, sys
path = sys.argv[1]
cmd = sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(8)
s.connect(path)
payload = cmd + "\nprintf '%s\\n' \"__QEMU_RC:$?\"\n"
s.sendall(payload.encode())
buf = b""
s.settimeout(2)
while True:
    try:
        chunk = s.recv(4096)
    except socket.timeout:
        break
    if not chunk:
        break
    buf += chunk
    if b"__QEMU_RC:" in buf:
        break
text = buf.decode("utf-8", "replace")
rc = 1
out = []
for line in text.splitlines():
    if line.startswith("__QEMU_RC:"):
        tail = line.split(":", 1)[1].strip()
        if tail.isdigit():
            rc = int(tail)
    else:
        out.append(line)
sys.stdout.write("\n".join(out))
if out:
    sys.stdout.write("\n")
sys.exit(rc)
PY
}

qemu_serial_shell() {
    _ss_sock=${1-}
    if ! command -v python3 >/dev/null 2>&1; then
        qemu_fail "python3 is missing. BusyBox execute and shell need python3."
        unset _ss_sock
        return 1
    fi
    if [ ! -S "${_ss_sock}" ]; then
        qemu_fail "Serial socket is missing."
        unset _ss_sock
        return 1
    fi
    python3 - "${_ss_sock}" <<'PY'
import os, select, socket, sys
path = sys.argv[1]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(8)
s.connect(path)
s.setblocking(False)
while True:
    r, _, _ = select.select([sys.stdin, s], [], [], 0.5)
    if sys.stdin in r:
        data = os.read(sys.stdin.fileno(), 4096)
        if not data:
            break
        s.sendall(data)
    if s in r:
        try:
            data = s.recv(4096)
        except BlockingIOError:
            data = b""
        if not data:
            break
        os.write(sys.stdout.fileno(), data)
PY
}

qemu_container_execute() {
    _ex_name=${1-}
    shift || true
    qemu_take_flag "$@" || return 1
    _ex_cmd="${QEMU_ARG_POS}"
    if [ -z "${_ex_cmd}" ]; then
        if [ "${TTY:-0}" -ne 1 ] || [ "${JSON:-0}" -eq 1 ] || [ "${QUIET:-0}" -eq 1 ]; then
            qemu_fail "Command to run inside this container is required."
            unset _ex_name _ex_cmd
            return 1
        fi
        prompt_ask "Command to run inside this container" ""
        _ex_cmd="${PROMPT_ASK_VALUE}"
    fi
    if [ -z "${_ex_cmd}" ]; then
        qemu_fail "Command to run inside this container is required."
        unset _ex_name _ex_cmd
        return 1
    fi
    qemu_ensure_tree || { unset _ex_name; return 1; }
    qemu_container_require_running "${_ex_name}" "execute" || { unset _ex_name; return 1; }
    if [ "${QEMU_C_FAMILY}" = "busybox" ]; then
        qemu_serial_run "${PERSISTENT_STORAGE_DIR}/containers/${_ex_name}.serial" ${_ex_cmd}
        _ex_rc=$?
    else
        qemu_ssh_run "${_ex_name}" ${_ex_cmd}
        _ex_rc=$?
    fi
    unset _ex_name _ex_cmd
    return ${_ex_rc}
}

qemu_container_shell() {
    _sh_name=${1-}
    if [ "${TTY:-0}" -ne 1 ] || [ "${JSON:-0}" -eq 1 ] || [ "${QUIET:-0}" -eq 1 ]; then
        qemu_fail "container shell needs a terminal."
        unset _sh_name
        return 1
    fi
    if ! qemu_name_ok "${_sh_name}"; then
        qemu_fail "Unknown container name '${_sh_name}'."
        unset _sh_name
        return 1
    fi
    qemu_ensure_tree || { unset _sh_name; return 1; }
    qemu_container_require_running "${_sh_name}" "shell" || { unset _sh_name; return 1; }
    if [ "${QEMU_C_FAMILY}" = "busybox" ]; then
        qemu_serial_shell "${PERSISTENT_STORAGE_DIR}/containers/${_sh_name}.serial"
        _sh_rc=$?
    else
        qemu_ssh_run "${_sh_name}" -t
        _sh_rc=$?
    fi
    unset _sh_name
    return ${_sh_rc}
}

qemu_container_remove() {
    _rm_name=${1-}
    if ! qemu_name_ok "${_rm_name}"; then
        qemu_fail "Unknown container name '${_rm_name}'."
        unset _rm_name
        return 1
    fi
    qemu_ensure_tree || { unset _rm_name; return 1; }
    if [ ! -f "$(qemu_container_json_path "${_rm_name}")" ]; then
        out_success "Container ${_rm_name} is already absent."
        unset _rm_name
        return 0
    fi
    qemu_confirm_or_force "Remove container ${_rm_name}"
    _rm_rc=$?
    if [ "${_rm_rc}" -eq 2 ]; then
        unset _rm_name _rm_rc
        return 0
    fi
    if [ "${_rm_rc}" -ne 0 ]; then
        unset _rm_name _rm_rc
        return 1
    fi
    qemu_container_load "${_rm_name}" || { unset _rm_name; return 1; }
    if [ "${QEMU_C_STATE}" = "running" ]; then
        qemu_container_stop "${_rm_name}" || { unset _rm_name; return 1; }
    fi
    rm -f "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}.json" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}.qcow2" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}.key" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}.pid" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}.monitor" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}.serial" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}.log" \
        "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}-cidata.iso"
    rm -rf "${PERSISTENT_STORAGE_DIR}/containers/${_rm_name}-cidata"
    out_success "Removed container ${_rm_name}."
    unset _rm_name _rm_rc
    return 0
}

qemu_container_main() {
    _cm_sub=${1-}
    if [ $# -gt 0 ]; then
        shift
    fi
    case "${_cm_sub}" in
        ""|list)
            qemu_container_list
            ;;
        create)
            qemu_container_create "$@"
            ;;
        start)
            _cm_name=""
            while [ $# -gt 0 ]; do
                case "${1}" in
                    --force) FORCE=1; shift ;;
                    *)
                        if [ -z "${_cm_name}" ]; then
                            _cm_name=${1}
                        fi
                        shift
                        ;;
                esac
            done
            qemu_container_start "${_cm_name}"
            _cm_rc=$?
            unset _cm_name
            return ${_cm_rc}
            ;;
        stop)
            _cm_name=""
            while [ $# -gt 0 ]; do
                case "${1}" in
                    --force) FORCE=1; shift ;;
                    *)
                        if [ -z "${_cm_name}" ]; then
                            _cm_name=${1}
                        fi
                        shift
                        ;;
                esac
            done
            qemu_container_stop "${_cm_name}"
            _cm_rc=$?
            unset _cm_name
            return ${_cm_rc}
            ;;
        execute)
            _cm_name=${1-}
            if [ $# -gt 0 ]; then
                shift
            fi
            qemu_container_execute "${_cm_name}" "$@"
            ;;
        shell)
            _cm_name=""
            while [ $# -gt 0 ]; do
                case "${1}" in
                    --force) FORCE=1; shift ;;
                    *)
                        if [ -z "${_cm_name}" ]; then
                            _cm_name=${1}
                        fi
                        shift
                        ;;
                esac
            done
            qemu_container_shell "${_cm_name}"
            _cm_rc=$?
            unset _cm_name
            return ${_cm_rc}
            ;;
        remove)
            _cm_name=""
            while [ $# -gt 0 ]; do
                case "${1}" in
                    --force) FORCE=1; shift ;;
                    *)
                        if [ -z "${_cm_name}" ]; then
                            _cm_name=${1}
                        fi
                        shift
                        ;;
                esac
            done
            qemu_container_remove "${_cm_name}"
            _cm_rc=$?
            unset _cm_name
            return ${_cm_rc}
            ;;
        *)
            qemu_fail "Unknown container command '${_cm_sub}'. See '${APP_NAME} help'."
            unset _cm_sub
            return 1
            ;;
    esac
}

qemu_container_names() {
    QEMU_NAME_COUNT=0
    _cn_dir="${PERSISTENT_STORAGE_DIR}/containers"
    if [ ! -d "${_cn_dir}" ]; then
        unset _cn_dir
        return 0
    fi
    _cn_names=$(find "${_cn_dir}" -maxdepth 1 -type f -name '*.json' 2>/dev/null | sed 's|.*/||; s|\.json$||' | sort)
    _cn_i=0
    if [ -n "${_cn_names}" ]; then
        _cn_old=${IFS}
        IFS='
'
        for _cn_one in ${_cn_names}; do
            [ -n "${_cn_one}" ] || continue
            _cn_i=$((_cn_i + 1))
            eval "QEMU_NAME_${_cn_i}=\${_cn_one}"
        done
        IFS=${_cn_old}
        unset _cn_old
    fi
    QEMU_NAME_COUNT=${_cn_i}
    unset _cn_dir _cn_names _cn_i _cn_one
    return 0
}

qemu_container_names_clear() {
    _cx=1
    while [ "${_cx}" -le "${QEMU_NAME_COUNT:-0}" ]; do
        eval "unset QEMU_NAME_${_cx}"
        _cx=$((_cx + 1))
    done
    QEMU_NAME_COUNT=0
    unset _cx
}

