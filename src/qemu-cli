# =============================================================================
# util_get_current_shell() - Detect current / parent shell name
# =============================================================================
#
# GENERAL PURPOSE:
# Returns a best-effort shell command name for diagnostics (about).
# Prefer parent shell when the current process is sh/dash/ash/the app itself.
#
# PRINTF EXCEPTION (class B – function return-via-stdout):
# Final printf '%s' "$shell" (and echo fallbacks inside $(…)) are data
# returns for capture by app_about — not product messages. Display uses out_*.
# See requirement-shell-output-requirements.md §2.1.1.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Nested functions are not portable POSIX; this must stay top-level.
#
# Last reviewed: 2026-07-12
# =============================================================================
util_get_current_shell() {
    local shell="unknown"
    shell=$(ps -p $$ -o comm= 2>/dev/null | tr -d '()' || echo "unknown")

    if [ "$shell" = "${APP_NAME}" ] || [ "$shell" = "sh" ] || \
       [ "$shell" = "dash" ] || [ "$shell" = "ash" ]; then
        local parent_pid
        parent_pid=$(ps -p $$ -o ppid= 2>/dev/null | tr -d ' ')
        if [ -n "$parent_pid" ]; then
            shell=$(ps -p "$parent_pid" -o comm= 2>/dev/null | tr -d '()' || echo "$shell")
        fi
    fi
    printf '%s' "$shell"
}


app_about() {
    # --- Safe Variable Defaults ---
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=qemu-cli}"
    # Version comes from global SSOT (VERSION="…" hard-assign near top); default only if unset
    : "${VERSION:=1.4.1}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SCRIPT_URL:=}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"

    # Cache folder + persistence (requirement-shell-cli-storage).
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    _cache_preferred=$(util_preferred_cache_dir)
    _cache_fallback=$(util_fallback_cache_dir)
    _cache_fallback_2=$(util_fallback2_cache_dir)
    STORAGE_DIR="${_cache_fallback}"
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    fi
    qemu_about_fill

    if [ "${JSON}" -eq 1 ]; then
        # === JSON MODE - Clean, machine-friendly output ===
        local installed="false"
        inst_is_installed && installed="true"

        local global_ver="not found"
        if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
            global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi

        local local_ver="not found"
        if [ -x "${USER_BIN}/${APP_NAME}" ]; then
            local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi

        local current_shell
        current_shell=$(util_get_current_shell)

        local interactive="false"
        [ -t 1 ] && interactive="true"

        local current_user
        current_user="$(id -un 2>/dev/null || echo "unknown")"

        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "${installed}" \
            "global_version" "${global_ver}" \
            "local_version" "${local_ver}" \
            "shell" "${current_shell}" \
            "interactive" "${interactive}" \
            "user" "${current_user}" \
            "cache_used" "${EFFECTIVE_STORAGE_DIR}" \
            "cache_preferred" "${_cache_preferred}" \
            "cache_fallback" "${_cache_fallback}" \
            "cache_fallback_2" "${_cache_fallback_2}" \
            "persistence_storage" "${PERSISTENT_STORAGE_DIR}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "qemu_present" "${QEMU_ABOUT_PRESENT}" \
            "qemu_bin" "${QEMU_ABOUT_BIN}" \
            "host_os_family" "${QEMU_ABOUT_FAMILY}" \
            "image_dir" "${QEMU_ABOUT_IMAGE_DIR}" \
            "container_dir" "${QEMU_ABOUT_CONTAINER_DIR}" \
            "kvm_usable" "${QEMU_ABOUT_KVM}"
        return 0
    fi

    # === Normal Human-readable Mode ===
    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - $(app_menu_text about_title) ==="
    out_empty_line

    # Installation status
    if inst_is_installed; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in your PATH."
        if [ -n "${SCRIPT_URL}" ]; then
            out_info "   Recommended: curl -fsSL ${SCRIPT_URL} | sh"
        else
            out_info "   Set SCRIPT_URL to the install script URL, then: curl -fsSL \"\${SCRIPT_URL}\" | sh"
        fi
    fi

    out_empty_line

    # Global vs Local installation details
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${global_ver}"
    else
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   not found"
    fi

    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${local_ver}"
    else
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    not found"
    fi

    out_empty_line

    local current_user
    current_user="$(id -un 2>/dev/null || echo "unknown")"
    out_info "Current user:      ${current_user}"

    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root (global install path available)"
    else
        out_info "Execution context: normal user (Type 0 CLI self-management)"
    fi

    out_empty_line

    local current_shell
    current_shell=$(util_get_current_shell)

    out_info "Current shell:     ${current_shell}"

    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no (non-interactive / scripted mode)"
    fi

    out_empty_line
    out_info "Cache folder used: ${EFFECTIVE_STORAGE_DIR}"
    out_info "Cache folder (preferred): ${_cache_preferred}"
    out_info "Cache folder (1st fallback): ${_cache_fallback}"
    if [ -n "${_cache_fallback_2}" ]; then
        out_info "Cache folder (2nd fallback): ${_cache_fallback_2}"
    fi
    out_info "Persistence storage: ${PERSISTENT_STORAGE_DIR}"

    qemu_about_human

    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help           → Full usage"
    out_info "   ${APP_NAME} self-install   → Place this CLI (copy when you run the file)"
    out_info "   ${APP_NAME} self-update    → Update to latest version"
    out_info "   ${APP_NAME} self-uninstall → Clean removal from system"
    out_info "   ${APP_NAME} --json         → Machine-readable output"

    out_empty_line
    out_info "Run '${APP_NAME} help' for complete usage information."
}

app_version() {
    : "${APP_NAME:=qemu-cli}"
    : "${VERSION:=1.4.1}"
    : "${JSON:=0}"
    if [ "${JSON}" -eq 1 ]; then
        # Same machine contract as historical app_main inline path
        out_json "version" "" "app" "${APP_NAME}" "version" "${VERSION}"
    else
        out_info "${APP_NAME} version ${VERSION}"
    fi
}

# =============================================================================
# app_help() - Display help for qemu-cli
# =============================================================================
#
# Shows usage, available commands, and global flags.
# Fully respects --quiet and --json modes.
#
# In --json mode: returns a minimal success object instead of long text.
# In --quiet mode: prints nothing (silent).
#
# Keep in sync with requirement-shell-cli-interface.md command table.
# =============================================================================

app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Shell script bootstrap for self Installation & Maintenance}}"
    : "${DESCRIPTION:=POSIX /bin/sh program that installs QEMU, keeps Ubuntu, Rocky Linux, Alpine, and busybox images, and starts, stops, and enters the guests it owns.}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, version-check, self-install, self-update, self-uninstall."
        return 0
    fi

    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line

    out_info "$(app_menu_text help_usage)"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line

    out_info "$(app_menu_text help_self_head)"
    out_plain "  self-install         Place ${APP_NAME} (copy when \$0 is this file; pipe downloads; 0755 global / 0700 local)"
    out_plain "  install              Same as self-install (compatibility alias)"
    out_plain "  version              Show current version"
    out_plain "  about                Show detailed diagnostics"
    out_plain "  version-check        Compare local vs remote version (needs SCRIPT_URL)"
    out_plain "  self-update          Update ${APP_NAME} to a newer remote version"
    out_plain "  self-uninstall       Remove ${APP_NAME} (safe PATH cleanup)"
    out_plain "  help                 Show this help"
    out_plain "  menu                 Numbered list on a terminal (1 setup, 2 images, 3 containers, 6 language, 8 self-management, 9 Exit). Help off a terminal"
    out_plain "  main                 Same as menu"
    out_empty_line

    qemu_help_rows

    out_info "$(app_menu_text help_flags_head)"
    out_plain "  --quiet, -q          Suppress info/success (errors and warnings still shown)"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Force reinstall / skip uninstall confirm / allow downgrade"
    out_plain "  --debug              Debug diagnostics on stderr"
    out_empty_line

    # Effective channel values (Config SSOT / env override) so help is actionable.
    # CHECKSUM is an install-path runtime pin only — never listed here (requirement-shell-automatic-checksum).
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=qemu-cli}"
    : "${SCRIPT_RELPATH:=src/${APP_NAME}}"
    : "${SCRIPT_URL:=}"

    out_info "$(app_menu_text help_env_head)"
    out_plain "  REPO_USER            ${REPO_USER}"
    out_plain "                       GitHub owner used to compose default SCRIPT_URL"
    out_plain "  REPO_NAME            ${REPO_NAME}"
    out_plain "                       GitHub repo used to compose default SCRIPT_URL"
    out_plain "  SCRIPT_RELPATH       ${SCRIPT_RELPATH}"
    out_plain "                       Repo path used to compose default SCRIPT_URL"
    if [ -n "${SCRIPT_URL}" ]; then
        out_plain "  SCRIPT_URL           ${SCRIPT_URL}"
    else
        out_plain "  SCRIPT_URL           (not set)"
    fi
    out_plain "                       Canonical install channel (override via env; needed for version-check/self-update)"
    out_empty_line
    out_info "On a terminal with no arguments the numbered list opens (same as menu)."
    out_info "A pipe, quiet, or json run with no arguments still places this program."
    out_empty_line
}

# Menu choice is a current-shell read in app_menu_prompt.
# The catalog function below must stay free of that builtin.

app_lang_load() {
    APP_LANG=en
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    _ll_path="${PERSISTENT_STORAGE_DIR}/language"
    if [ -f "${_ll_path}" ]; then
        _ll_line=$(head -n 1 "${_ll_path}" 2>/dev/null || true)
        _ll_line=$(printf '%s' "${_ll_line}" | tr -d '\r')
        case "${_ll_line}" in
            en|zh-Hant|es|fr|de|zh-Hans|ja|ko) APP_LANG="${_ll_line}" ;;
        esac
    fi
    case "${QEMU_CLI_LANG-}" in
        en|zh-Hant|es|fr|de|zh-Hans|ja|ko) APP_LANG="${QEMU_CLI_LANG}" ;;
    esac
    export APP_LANG
    unset _ll_path _ll_line
}

app_lang_save() {
    _ls_code=${1-}
    case "${_ls_code}" in
        en|zh-Hant|es|fr|de|zh-Hans|ja|ko) ;;
        *) unset _ls_code; return 1 ;;
    esac
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    _ls_path="${PERSISTENT_STORAGE_DIR}/language"
    if ! printf '%s\n' "${_ls_code}" > "${_ls_path}"; then
        unset _ls_code _ls_path
        return 1
    fi
    chmod 0600 "${_ls_path}" 2>/dev/null || true
    APP_LANG="${_ls_code}"
    export APP_LANG
    unset _ls_code _ls_path
    return 0
}

