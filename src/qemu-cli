        fi
        return 1
    fi
    if ! cp "${_src}" "${_tmp}"; then
        rm -f "${_tmp}" 2>/dev/null || true
        if [ "${JSON}" -eq 1 ]; then
            out_json_error "Failed to copy ${_src}" "io_error"
        else
            out_error "Failed to copy ${_src}"
